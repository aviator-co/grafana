# Preview-environment image for Aviator Verify.
#
# IMPORTANT: Aviator never reads this file. The image that actually boots is
# built by e2b from the Dockerfile text pasted into
#   Verify -> Settings -> Sandbox -> Custom templates -> Add -> From Dockerfile
# This copy exists so the image is reviewable in the repo. Editing it changes
# nothing until it is re-pasted and rebuilt. Keep the two in sync.
#
# Iterate locally before touching e2b (a full e2b build is ~15-25 minutes,
# though it caches unchanged leading layers and resumes at the first edit):
#   docker build -f .aviator/preview/Dockerfile --platform linux/amd64 -t grafana-preview:test .
#   docker run --rm -it -p 3000:3000 grafana-preview:test bash
#
# Constraints this file is written to:
#   * No CMD/ENTRYPOINT   - Aviator never runs the container normally. It boots
#                           the sandbox and runs .aviator/scripts/preview-setup.sh
#                           inside it.
#   * No COPY/ADD         - the "Add custom template" Dockerfile parser rejects
#                           them; there is no build context. Anything that would
#                           need COPY is generated by the setup script instead.
#   * No Chrome/Playwright- the browser runs on Aviator's worker, not in here.
#                           It reaches this box over the public e2b URL.
#   * e2b forces its own PATH for every RUN step
#       /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#     and does not carry this file's ENV into the sandbox at run time, so
#     everything the setup script needs must be reachable from that PATH.
#     `ENV PATH=...` does not override it.

# Matches .nvmrc (v24.11.0) and package.json engines (">= 22 <25").
# node/npm/yarn/corepack live in /usr/local/bin, which IS on e2b's forced PATH.
# A Node base also keeps the step Aviator appends to every Dockerfile-sourced
# template working: `npm install -g @anthropic-ai/claude-code`.
FROM node:24-bookworm

ARG DEBIAN_FRONTEND=noninteractive

# Keep in sync with GO_VERSION in the Makefile and the `go` directive in go.mod.
ARG GO_VERSION=1.26.5

#   git / git-lfs   - Aviator checks the runbook's branch out in /code
#   build-essential - make (the backend build is driven by the Makefile) plus a
#                     C toolchain for any cgo-enabled dependency
#   curl            - fetches the Go toolchain here, and is the readiness poll
#                     in the setup script
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git git-lfs ca-certificates curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# The Go tarball unpacks to /usr/local/go/bin, which is NOT on e2b's forced
# PATH, and an ENV here would not survive into the sandbox either. Symlinking
# into /usr/local/bin is the one approach that works in both the template
# builder and the running sandbox.
# The architecture is detected rather than hardcoded. e2b always builds amd64,
# but this keeps a local `docker build` native (and therefore fast) on an Apple
# Silicon machine; emulating amd64 to compile grafana takes hours.
RUN GO_ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && ln -sf /usr/local/go/bin/go /usr/local/bin/go \
    && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt \
    && go version

# yarn 4 (package.json: "packageManager": "yarn@4.17.1") comes from corepack.
RUN corepack enable

# Clone the fork Aviator is connected to, so /code's origin matches at runtime
# and the launch takes the git-fetch fast path. On a mismatch Aviator silently
# does `rm -rf /code` and re-clones, destroying every cache baked below — and it
# never fails loudly, it just gets slow.
#
# --filter=blob:none, NOT --depth 1 / --single-branch: a shallow single-branch
# clone only tracks main, so `git fetch origin <runbook-branch>` would never
# create origin/<branch> and the checkout fails with "invalid reference".
RUN git clone --filter=blob:none https://github.com/aviator-co/grafana.git /code
WORKDIR /code

# ---------------------------------------------------------------------------
# Bake the four expensive steps.
#
# The launch cleans the tree with `git clean -fd` — no -x — so gitignored paths
# SURVIVE. That is the entire caching mechanism, and .gitignore is literally the
# list of what may be cached. Everything below lands in an ignored path:
#
#   node_modules/ (incl. node_modules/.cache/webpack)  "node_modules"
#   public/build/                                      "/public/build"
#   public/app/plugins/**/dist/                        "public/app/plugins/**/dist/"
#   .nx/                                               ".nx"
#   bin/grafana                                        "/bin/*"
#
# The Go build and module caches (/root/.cache/go-build, /root/go/pkg/mod) sit
# outside /code, so git never touches them at all.
# ---------------------------------------------------------------------------

# .yarnrc.yml sets enableScripts: false, so no package lifecycle scripts run.
# `yarn cache clean` afterwards drops the global download cache, which is worth
# several GB of image size and is only needed again when yarn.lock moves.
RUN yarn install --immutable && yarn cache clean

# The three frontend steps below are what `yarn dev` would do via nx (its
# project.json target declares dependsOn: themes-generate + every
# tag:scope:plugin build), run explicitly instead. See the webpack step for why.

# Generated SCSS variable files, consumed by the sass entrypoints. Takes ~4s.
RUN yarn themes-generate

# Core datasource plugins are decoupled: each builds to its own dist/ and the
# backend serves it from there, so without this every datasource UI 404s.
# Uses the `build` target, not `dev`: the plugins' `dev` script is `webpack -w`
# and would never exit, and `build` is nx-cached with outputs {projectRoot}/dist,
# so the setup script's re-run is a cache hit when the branch touched no plugin.
#
# --maxParallel=1 is not conservatism, it is a measured failure: at nx's default
# of 3, three concurrent webpack processes (azure-monitor at 1296 modules,
# influxdb at 1451, mysql) each inherited the 3 GB heap allowance below on a
# 4 GB builder, and mysql was killed outright — no output, no heap-limit trace.
# These flags go to `nx run-many`, which parses them correctly.
RUN NX_DAEMON=false NODE_OPTIONS=--max-old-space-size=2048 \
    yarn plugin:build --maxParallel=1

# Main bundle, invoking webpack DIRECTLY rather than through `yarn dev`.
#
# `yarn dev` is `nx exec -- webpack ...`, and nx exec re-parses trailing args.
# `yarn dev --env noTsCheck=1 --env noLint=1` reached webpack as
#     yarn nx run grafana:"dev" noTsCheck=1 --env noLint=1
# with the first --env swallowed by nx, so ForkTsCheckerWebpackPlugin (which
# asks for an 8 GB heap) and eslint both stayed ON. Calling webpack directly is
# the only way to be certain the flags land. It also skips nx's dependency
# graph, which would otherwise rebuild the plugins above a second time.
#
# Other flags:
#   * development, not `yarn build`: production is minified and several times
#     slower for no benefit to a preview.
#   * webpack.dev.ts declares a persistent filesystem cache under
#     node_modules/.cache, so it survives the launch cleanup — that cache is
#     what makes the per-preview rebuild incremental instead of cold.
#   * --env react19=1 emits assets-manifest-react19.json, the manifest
#     pkg/api/webassets reads while the `react19` toggle is on (registry
#     default "true"). The setup script pins the toggle so the two cannot drift.
# --no-devtool is what makes this fit in 4 GB.
#
# webpack.dev.ts hardcodes devtool: 'source-map'. For a graph this size that
# means holding a second copy of every module plus its mapping table, all
# retained until the assets are emitted — so peak memory lands at the very end.
# Measured on this box, with source maps on, there was no heap cap that worked:
#   3072 -> ran 8 min, then the kernel SIGKILLed the process (RSS passed the
#           4 GB cgroup while V8 still thought it had headroom, so it had never
#           run a hard major GC)
#   2048 -> died in 57s with "FATAL ERROR: Ineffective mark-compacts near heap
#           limit", i.e. V8's own ceiling
# webpack-cli 6.0.1 (the version pinned in package.json) generates --no-devtool
# from the schema, and CLI options override the config, so this needs no change
# to any grafana file. A preview agent never opens a debugger; source maps buy
# nothing here and cost the whole memory budget.
#
# The cap bounds V8's old space ONLY. Node's own overhead and swc-loader's
# native Rust allocations sit on top of it, which is why it has to stay well
# under 4096 rather than close to it.
RUN NODE_ENV=dev NX_DAEMON=false NODE_OPTIONS=--max-old-space-size=2560 \
    node_modules/.bin/webpack --config scripts/webpack/webpack.dev.ts \
        --no-devtool \
        --env react19=1 --env noTsCheck=1 --env noLint=1

# Backend. Writes ./bin/grafana and populates the Go build cache.
# wire_gen.go and themes_generated.go are committed, and the make rule for the
# latter has no prerequisites, so this needs no code generation step.
#
# GOFLAGS, both halves of which are load-bearing:
#
#   -v   makes `go build` name each package as it compiles. Without it the step
#        prints module downloads for ~30s and then goes SILENT for the entire
#        compile. A build here died exactly 30m08s into that silence with the
#        client reporting [Errno 60] Operation timed out — the log stream idled
#        out while the compile was still running fine. Steady output keeps the
#        connection alive, and doubles as progress.
#   -p=2 caps parallel compile jobs. The default is GOMAXPROCS (4 here), and
#        four concurrent Go compiles of grafana-sized packages in 4 GB is the
#        same over-commitment that killed the plugin builds at nx's default
#        parallelism. Raise it if the box ever gets more memory.
RUN GOFLAGS="-v -p=2" make build-go

# Record the commit these caches were built from, OUTSIDE /code — a file inside
# /code would be deleted by the launch's `git clean -fd`.
RUN git -C /code rev-parse HEAD > /preview-image-sha
